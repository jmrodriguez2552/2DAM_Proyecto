<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OtrosDocumentosFragment">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fondo5"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona el documento"
            android:textColor="@color/pastelOrange"
            android:textSize="32dp"
            android:textStyle="bold">

        </TextView>

        <Spinner
            android:id="@+id/spinnerDocument"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="20dp">

        </Spinner>

        <Button
            android:id="@+id/btnDocument"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:backgroundTint="@color/pastelOrange"
            android:text="Consultar Documento"
            android:textColor="@color/mintGreen"
            android:textSize="24dp"
            android:textStyle="bold">

        </Button>



    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>